# Created by BotFather. Keep this file mode 600 and never paste the token into chat.
TELEGRAM_BOT_TOKEN=replace-me

# Comma-separated numeric IDs.
# Private chats: BOTH the user ID and the chat ID must be allowlisted.
# Groups/supergroups (this fork): a group chat ID listed in
# TELEGRAM_ALLOWED_CHAT_IDS admits messages from ANY member of that group.
# Group IDs are negative (e.g. -1001234567890). Only add groups you control.
TELEGRAM_ALLOWED_USER_IDS=replace-me
TELEGRAM_ALLOWED_CHAT_IDS=replace-me

# Must be a loopback host. Non-loopback URLs are rejected.
GROK_GATEWAY_URL=http://127.0.0.1:1340
# Prefer Grok Bot's existing gateway discovery record. Tighten that file to
# mode 600 first. The bridge reads the token in memory and does not copy it.
GROK_GATEWAY_TOKEN_FILE=/home/box/sand-data/gateway.json
# Alternative: the gateway token itself. When set, it is used instead of the file.
# GROK_GATEWAY_TOKEN=replace-me
# Agent name or agent id (this fork also accepts ids).
GROK_DEFAULT_AGENT="Chief of Staff"

# Optional desktop-to-Telegram mirroring. Set both or neither. These exact IDs
# must also appear in the corresponding Telegram allowlists above.
# GROK_DESKTOP_MIRROR_CHAT_ID=replace-me
# GROK_DESKTOP_MIRROR_USER_ID=replace-me

# Keep state on the Grok computer persistent volume, not in a public checkout.
BRIDGE_STATE_PATH=/home/box/grokbot-telegram-bridge/bridge-state.json

# Optional tuning.
GROK_REPLY_TIMEOUT_MS=600000
GROK_POLL_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# Group and forum options (this fork). All optional.
# ---------------------------------------------------------------------------

# Forum topic allowlist (comma-separated topic ids). Empty/unset = all topics.
# The General topic is id 1; a forum message without a thread id counts as General.
# Private chats are never topic-filtered.
# TELEGRAM_ALLOWED_TOPIC_IDS=1,111

# JSON map of topic id -> display name for the [telegram-topic] prompt header.
# Names are also learned automatically from Telegram topic service messages.
# TELEGRAM_TOPIC_NAMES={"111":"Example Topic"}

# Per-topic agent routing: comma-separated <topicIdOrName>=<agentIdOrName>.
# Numeric keys are forum topic ids and win over name keys; other keys match the
# topic name case-insensitively (learned names are persisted in BRIDGE_STATE_PATH).
# Mapped topics are admitted even if not in TELEGRAM_ALLOWED_TOPIC_IDS, skip the
# group keyword filter, get their own queue, and forward all real
# text/photos/documents/voice notes. Unmapped traffic uses GROK_DEFAULT_AGENT.
# TELEGRAM_TOPIC_AGENTS="Example Topic=Example Agent,222=00000000-0000-0000-0000-000000000000"

# Group fast-path keywords (comma-separated, case-insensitive). A group message
# containing one is forwarded like a mention (no soft-forward hint). Latin
# single words match on word boundaries; phrases and CJK match as substrings.
# Empty/unset = only mentions, slash commands, and replies to the bot are fast-path.
# TELEGRAM_GROUP_KEYWORDS=support,help desk,ticket

# Instruction prepended to other (soft-forwarded) group messages in unmapped
# topics. The [telegram-group-hybrid] tag is added automatically. The agent
# should answer exactly NO_TELEGRAM_REPLY to stay silent.
# TELEGRAM_GROUP_HINT="Reply only to support requests. Otherwise reply exactly NO_TELEGRAM_REPLY."

# Extra instruction appended to voice-note/audio prompts, e.g. which local
# transcription tool the agent may use.
# TELEGRAM_VOICE_PROMPT_HINT="If you must transcribe locally, use only the preinstalled whisper CLI."

# Photo/album bundling: several photos (an album, or a quick burst from the same
# sender in the same topic) plus a following caption/text become ONE Grok turn.
# TELEGRAM_MEDIA_BUNDLING=on
# TELEGRAM_BUNDLE_ALBUM_DEBOUNCE_MS=1800
# TELEGRAM_BUNDLE_BURST_WINDOW_MS=3000
# TELEGRAM_BUNDLE_MAX_WAIT_MS=8000
# TELEGRAM_BUNDLE_MAX_ITEMS=10
